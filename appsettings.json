{
  "RenderEngineOptions": {
    "TemplateCache": {
      "Enabled": true,
      "SizeLimitMiB": 16,
      "ExpirationMinutes": 30
    },
    "Groups": {
      "station": {
        "ProviderId": "stationProvider",
        "RequiredContext": [
          "stationId"
        ],
        "AllowUnlistedMembers": true,
        "AllowStructuredValues": true,
        "Members": {
          "name": {
            "SourceField": "stationName"
          }
        }
      }
    },
    "Fields": {
      "instruments": {
        "ProviderId": "station-http",
        "SourceField": "instruments",
        "RequiredContext": [
          "stationId"
        ],
        "AllowStructuredValues": true
      },
      "products": {
        "ProviderId": "station-http",
        "SourceField": "products",
        "AllowStructuredValues": true
      },
      "sky": {
        "ProviderId": "station-http",
        "SourceField": "sky",
        "OnMissingValue": "DefaultValue",
        "DefaultValue": "unreported"
      },
      "label": {
        "ProviderId": "station-http",
        "SourceField": "label",
        "EmptyValueMode": "NullOrWhiteSpace",
        "OnMissingValue": "Empty"
      },
      "requiredProducts": {
        "ProviderId": "station-http",
        "SourceField": "missingCatalog",
        "AllowStructuredValues": true,
        "OnMissingValue": "Error"
      }
    }
  }
}
